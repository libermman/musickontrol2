<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos de Audio y Almacenamiento -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- ✅ PERMISO PARA PERSISTENCIA DE URI (IMPORTANTE PARA USB) -->
    <uses-permission android:name="android.permission.MANAGE_DOCUMENTS" />

    <!-- Permisos para MediaSession y Mandos del Volante -->
    <uses-permission android:name="android.permission.MEDIA_CONTENT_CONTROL" />

    <!-- Feature: Android Automotive OS -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />


    <!-- Compatibilidad con almacenamiento USB en Android Automotive -->
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <!-- Feature: Redimensionamiento de ventana (AAOS) -->
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false" />

    <!-- Feature: modo noche / dia (AAOS) -->
    <uses-permission android:name="android.permission.ACCESS_LIGHT_SENSOR" />

    <application
        android:allowBackup="true"
        android:theme="@style/Theme.MusicKontrol"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name"
        android:resizeableActivity="true"
        android:supportsPictureInPicture="false"
        android:appCategory="audio"
        android:directBootAware="true">

        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".activity.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:screenOrientation="landscape"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|smallestScreenSize">

            <!-- Prueba local para mantener nuestra Activity durante la conducción. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Servicio interno para los controles que ya usa MusicKontrol. -->
        <service
            android:name=".service.MediaSessionService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Servicio multimedia visible para AAOS/Nissan. -->
        <service
            android:name=".service.MusicLibraryService"
            android:enabled="true"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </service>

    </application>

</manifest>